AIMAC_PORT=4317
AIMAC_HOST=0.0.0.0
AIMAC_RUNTIME_DIR=.runtime
AIMAC_REPOSITORY_ROOT=.
AIMAC_EXECUTION_PROFILE=production
AIMAC_PUBLIC_URL=http://127.0.0.1:4317
# 是否信任 X-Forwarded-For 作为客户端 IP（默认 false）。登录节流按 IP 计数，所以这个开关直接决定
# 节流拦得住谁：前面【没有】可信代理却设成 true，任何人自带一个 X-Forwarded-For 就能每次换一个"IP"，
# 登录节流形同不存在，口令可被无限次尝试。只有当控制面确实只经由你控制的反向代理对外时才设 true。
AIMAC_TRUST_PROXY=false
AIMAC_STATE_STORE=runtime_json
AIMAC_MCP_CONFIG_DIR=.runtime/mcp-client-configs
AIMAC_SYSTEM_ADMIN_EMAIL=system.admin@local
AIMAC_SYSTEM_ADMIN_NAME=System Owner
# Use long random values when setting these locally. Leave commented for first-run local defaults.
# scripts/docker-up.sh generates and persists local Docker values automatically when these are unset.
# AIMAC_BOOTSTRAP_TOKEN=
# AIMAC_MCP_SERVICE_TOKEN=
# AIMAC_LOCAL_SEED_WORKSPACE_OWNER_TOKEN=
# AIMAC_LOCAL_SEED_REVIEWER_TOKEN=
# AIMAC_LOCAL_SEED_AGENT_RUNTIME_TOKEN=
AIMAC_AGENT_RUNTIME_EXECUTOR_COMMAND=
AIMAC_ALLOW_LOCAL_DETERMINISTIC_WORKER=false
AIMAC_ALLOW_INSECURE_REMOTE_MCP=false
# Organization defaults and system overview (defaults shown; uncomment to override).
# AIMAC_ORG_DEFAULT_MAX_MEMBERS=50
# AIMAC_ORG_DEFAULT_MAX_PROJECTS=20
# AIMAC_ORG_DEFAULT_MAX_TASK_GROUPS=200
# AIMAC_ORG_DEFAULT_MAX_AGENTS=100
# AIMAC_ENERGY_WATTS_PER_CPU=15
# Agent host data root & session retention.
# AIMAC_AGENT_DATA_ROOT=
# AIMAC_AGENT_REGION=
# AIMAC_AGENT_KEEP_SESSION_DIRS=false
# Performance / hardening knobs (defaults shown; uncomment to override).
# AIMAC_KEEP_ALIVE_TIMEOUT_MS=65000
# AIMAC_REQUEST_TIMEOUT_MS=300000
# 单 IP 每分钟允许的失败登录次数（默认 10，下限 3）。调高等于放宽暴力破解的窗口；
# 与 AIMAC_TRUST_PROXY 配套看：后者决定"IP"是不是可信，这里决定同一个 IP 能试几次。
# AIMAC_LOGIN_ATTEMPTS_PER_MINUTE=10
# AIMAC_HEARTBEAT_PERSIST_FLOOR_MS=120000
# AIMAC_RUNTIME_JSON_PRETTY=false
# AIMAC_PROJECT_EVENT_IDEMPOTENCY_KEYS=500
# AIMAC_AGENT_REQUEST_TIMEOUT_MS=30000
# AIMAC_AGENT_EXECUTION_KEEPALIVE_MS=60000
# Real-time WebSocket push (/api/realtime) ping interval for dead-client detection.
# AIMAC_REALTIME_HEARTBEAT_MS=30000
# Hosted multi-tenant deployments should set this to "false" to forbid file://+local-path git
# remotes in checkpoint verification (ext::/fd:/remote-helper transports are always rejected).
# AIMAC_ALLOW_LOCAL_GIT_REMOTE=true
# POSTGRES_PASSWORD=
DATABASE_URL=postgres://aimac:aimac@localhost:55432/aimac
# Postgres backend (AIMAC_STATE_STORE=postgresql) uses a pooled pg client running in a
# worker thread; these tune the pool. Defaults shown.
# AIMAC_PG_POOL_MAX=10
# AIMAC_PG_POOL_IDLE_MS=30000
# AIMAC_PG_POOL_CONNECT_TIMEOUT_MS=10000
# AIMAC_PG_QUERY_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# 配错会削弱某条保证的开关。这里只列这一类 —— 内部容量上限与 agent 侧测试钩子刻意不列，
# 词表里的噪声会让真正要紧的条目不再被阅读。每一条都写明【默认值】与【调错的后果】。
# ---------------------------------------------------------------------------

# 状态机强制模式。默认 strict：非法转移直接抛错。设成 warn/0/false/off 之后，非法转移
# 【照样发生】，只在 stdout 留一行 —— 而 stdout 在事后排查时通常已经没了。
# 生产环境不要动它；调成 warn 等于把整套状态机降级成建议。
# AIMAC_TRANSITION_STRICT=strict

# 后台自治周期（毫秒）。控制面靠它推进编排：设成 0 就没有任何东西驱动自治循环，
# 人建完任务组会一直等下去（而页面上写着"会自动生成"）。端到端脚本用 0 关掉它以保证断言确定性。
# AIMAC_ORCHESTRATOR_INTERVAL_MS=60000

# 撤销一个节点之后，它的凭据还能用多久（毫秒，默认 10 分钟）。这段时间是给【配合的】节点
# 确认撤销指令用的（它需要有效凭据才能 ACK）；期限一过，凭据无条件作废，不管节点是否还在心跳。
# 调大＝一个已知失陷的节点多活这么久。已知失陷时请用控制台的「立即切断」，不要靠这个值。
# AIMAC_REVOCATION_ACK_TIMEOUT_MS=600000

# 注册重放窗口（毫秒，默认 10 分钟）。窗口内同一幂等键的重试拿回同一份注册结果；
# 窗口一过，状态里那份【明文节点令牌】被抹除。调大＝一份 30 天有效的凭据在状态库与备份里多留这么久。
# AIMAC_REGISTER_REPLAY_WINDOW_MS=600000

# 幂等响应体保留期（毫秒，默认 10 分钟）。过期后只保留冲突检测所需字段，响应体被清掉。
# 调大＝中央状态文档变大，而它每次写入都整份重写（Postgres 下还会重写全部分片行）。
# AIMAC_IDEMPOTENCY_PAYLOAD_TTL_MS=600000

# 节点失联与退役判定（毫秒）。前者决定多久把一个不心跳的节点扫成 offline 并收回它的派发；
# 后者决定多久把它退役。调大＝一个已经死掉的节点在控制台上继续显示为在线更久。
# AIMAC_NODE_HEARTBEAT_TIMEOUT_MS=900000
# AIMAC_NODE_RETIRE_TIMEOUT_MS=604800000

# 协作房间的容量。单条上限挡在门口，总字节预算兜住总量 —— roomMessages 不分片、整批驻留
# 中央状态文档，而它每次写入都整份重写。调大它们等于让任意一次无关写入都变慢。
# AIMAC_ROOM_MESSAGE_MAX_BYTES=32768
# AIMAC_ROOM_MESSAGES_MAX_TOTAL_BYTES=67108864
# AIMAC_ROOM_SEQUENCE_MAX_ROOMS=5000
# AIMAC_ROOM_PARTICIPANTS_MAX=5000

# MCP 服务令牌的作用面。留空＝用内置白名单。显式配置时注意：真人专属的动作（批准权限、
# 改规则层、发布共享定义）即使配进来也会在决策点被拒 —— 它们不该由机器主体完成。
# AIMAC_MCP_SERVICE_ALLOWED_TOOLS=
# AIMAC_MCP_SERVICE_PROJECT_IDS=prj_control_plane

# 持久化 fsync。默认开。关掉＝崩溃/断电后可能读到半截或过期的状态文档。
# 只在明确接受这个代价的一次性环境里关。
# AIMAC_RUNTIME_JSON_FSYNC=true

# 登录页是否显示本机令牌与系统管理员账号提示。默认仅在回环地址 + 非生产 profile 下显示。
# 在公网可达的部署上打开它，等于把管理员凭据的一半交给任何来访者。
# AIMAC_EXPOSE_BOOTSTRAP_HINT=false
