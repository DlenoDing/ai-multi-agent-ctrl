{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dleno.dev/ai-multi-agent-ctrl/spec/review-bundle.schema.json",
  "title": "ReviewBundle",
  "description": "控制面内登记的引用式 advisory review evidence bundle。它是非终态时会挡住关闭门的 no_pending_review_bundles，由 review_result_consume 终结 —— 也就是「旁路/外部评审结果尚未被本地采纳或驳回」的可解阻塞。当前实现只保存证据引用、checkpoint 引用和人工处置留痕，不外发证据内容，也不声称已经实现 provider 投递、外发 redaction、payloadDigest 或 provider grant。若将来接入真实外部评审发送通道，必须同步实现外发适配器、脱敏策略、payload digest、provider 授权与回执核验，再扩展本 schema；不能只在规范里预写字段。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewBundleId",
    "projectId",
    "taskGroupId",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "review-bundle/v1"
    },
    "reviewBundleId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "taskGroupId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "assembling",
        "redacted",
        "submitted",
        "blocked",
        "consumed",
        "rejected"
      ]
    },
    "artifactRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkpointRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersededByHumanDecision": {
      "type": [
        "boolean",
        "string",
        "object"
      ],
      "description": "人已就同一对象拍板时的留痕：外部评审结论不得反过来推翻人的定稿。"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "resolvedBy": {
      "type": "string",
      "description": "人工处置该证据包的账号。收尾是人的决定，必须留名。"
    },
    "resolutionJustification": {
      "type": "string",
      "description": "人工收尾的理由；与 resolvedBy 一起构成这次放行的依据。"
    }
  }
}
