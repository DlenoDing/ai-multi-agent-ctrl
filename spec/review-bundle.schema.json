{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dleno.dev/ai-multi-agent-ctrl/spec/review-bundle.schema.json",
  "title": "ReviewBundle",
  "description": "交付给外部评审方的证据包。它是非终态时会挡住关闭门的 no_pending_review_bundles，由 review_result_consume 终结 —— 也就是「外部评审还没回来」的可解阻塞。本规范此前描述的是一套更大的设计（reviewPlanId / reviewBatchId / scopeRoot / includedLocators / forbiddenPatterns / redaction / payloadDigest / providerPolicy / auditRef），而实现从未产出过那些字段 —— 规范没被拿去校验过任何真实记录，两边就一直各说各的。现按【实际产出】收窄。收窄的依据是：脱敏与投递策略这一层在当前实现里不存在（证据以引用形式留在控制面内，不外发内容），凭空要求这些字段只会让规范恒不成立；真外发时应连同实现一起补回，而不是先在规范里写着。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewBundleId",
    "projectId",
    "taskGroupId",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "review-bundle/v1"
    },
    "reviewBundleId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "taskGroupId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "assembling",
        "redacted",
        "submitted",
        "blocked",
        "consumed",
        "rejected"
      ]
    },
    "artifactRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "checkpointRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersededByHumanDecision": {
      "type": [
        "boolean",
        "string",
        "object"
      ],
      "description": "人已就同一对象拍板时的留痕：外部评审结论不得反过来推翻人的定稿。"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "resolvedBy": {
      "type": "string",
      "description": "人工处置该证据包的账号。收尾是人的决定，必须留名。"
    },
    "resolutionJustification": {
      "type": "string",
      "description": "人工收尾的理由；与 resolvedBy 一起构成这次放行的依据。"
    }
  }
}
