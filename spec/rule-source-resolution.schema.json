{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dleno.dev/ai-multi-agent-ctrl/spec/rule-source-resolution.schema.json",
  "title": "RuleSourceResolution",
  "description": "外部规则来源的采纳判定：某份外部材料算「生效规则」还是「仅供参考」。classification 决定 adoptionPolicy，未settle 前挡住关闭门。本规范此前描述的是一套更大的设计（sourceLocator / authorityLevel / sourceDigest / activeRuleRefs / referenceOnlyRefs / excludedSourceRefs / conflictCheck / auditRef），而实现从未产出过那些字段 —— 规范没被拿去校验过任何真实记录，两边就一直各说各的。现按【实际产出】收窄。收窄的依据是：当前实现的判定粒度是「整份来源」而不是「逐条规则」，因此逐条的 active/reference/excluded 三分与冲突检查没有产出者；承重的是 classification→adoptionPolicy 这条推导，以及 settledBy/settlementJustification 这份人工留痕。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "resolutionId",
    "projectId",
    "taskGroupId",
    "sourceRef",
    "sourceScope",
    "status",
    "classification",
    "adoptionPolicy",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "rule-source-resolution/v1"
    },
    "resolutionId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "taskGroupId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1
    },
    "sourceScope": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "discovered",
        "resolved",
        "active",
        "reference_only",
        "quarantined",
        "rejected",
        "superseded"
      ]
    },
    "classification": {
      "type": "string",
      "minLength": 1
    },
    "adoptionPolicy": {
      "type": "string",
      "minLength": 1,
      "description": "由 classification 推导：generic_mechanism → external_review_required，其余 → not_active_rule。缺省不得等于「已采纳」。"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "settledBy": {
      "type": "string"
    },
    "settlementJustification": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  }
}
