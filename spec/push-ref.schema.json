{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dleno.local/spec/push-ref.schema.json",
  "title": "PushRef",
  "type": "object",
  "additionalProperties": false,
  "required": ["repo", "remote", "ref", "sourceCommit", "remoteSha", "providerOperationId", "verifiedAt"],
  "properties": {
    "repo": {
      "type": "string",
      "minLength": 1
    },
    "remote": {
      "type": "string",
      "minLength": 1
    },
    "ref": {
      "type": "string",
      "minLength": 1
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{7,64}$"
    },
    "remoteSha": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{7,64}$"
    },
    "providerOperationId": {
      "type": "string",
      "minLength": 1
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time"
    },
    "rewriteRelation": {
      "type": "string",
      "enum": ["same_commit", "merge_commit", "rebased_commit"],
      "default": "same_commit"
    },
    "remoteAdvancedContained": {
      "type": "boolean",
      "description": "提交检查点后远端分支已前进，但仍包含本检查点 remoteSha 时由控制面写入。"
    },
    "observedRemoteSha": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{7,64}$",
      "description": "控制面复核时看到的当前远端 SHA，仅在 remoteAdvancedContained 为 true 时出现。"
    }
  }
}
