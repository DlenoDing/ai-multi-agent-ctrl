{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dleno.local/spec/checkpoint.schema.json",
  "title": "Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "taskGroupId",
    "workId",
    "sessionId",
    "runId",
    "stateVersion",
    "summary",
    "nextSteps",
    "openMachineActionIds",
    "derivedWorkRequests",
    "returnPointRef",
    "commitRefs",
    "pushRefs",
    "repositoryOutputTargetRefs",
    "artifactManifestRefs",
    "changedPathEvidenceRefs",
    "evidenceRefs",
    "languagePolicyDigest",
    "outputContractDigest",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "checkpoint/v1"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "taskGroupId": {
      "type": "string",
      "minLength": 1
    },
    "workId": {
      "type": "string",
      "minLength": 1
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "stateVersion": {
      "type": "integer",
      "minimum": 1
    },
    "taskContractDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "nextSteps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "actionId",
          "mode",
          "summary",
          "evidenceRefs"
        ],
        "properties": {
          "actionId": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string",
            "enum": [
              "current_absorb",
              "preempt_current",
              "after_current",
              "scheduled_after",
              "backlog",
              "none"
            ]
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "evidenceRefs": {
            "$ref": "#/$defs/refArray"
          }
        }
      }
    },
    "openMachineActionIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "derivedWorkRequests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "returnPointRef": {
      "type": "string",
      "minLength": 1
    },
    "commitRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "commit-ref.schema.json"
      }
    },
    "pushRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "push-ref.schema.json"
      }
    },
    "repositoryOutputTargetRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifactManifestRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "changedPathEvidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "languagePolicyDigest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "outputContractDigest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "reportedCreatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "执行方自报的检查点时间。仅作留档，【不】参与验收卡片挑选检查点的排序 —— 落库时间以服务端写的 createdAt 为准，否则执行方能决定人看到哪一份检查点。"
    },
    "selfReportedChangedPathEvidenceRefs": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "string"
      },
      "description": "执行方自报的改动路径证据。与真实 diff 无关，故独立成字段留档；控制面判定用的 evidenceRefs 由服务端从真实 diff 派生。"
    }
  },
  "$defs": {
    "refArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
