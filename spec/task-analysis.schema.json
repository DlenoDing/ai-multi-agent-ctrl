{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dleno.local/spec/task-analysis.schema.json",
  "title": "TaskAnalysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskGroupId",
    "items",
    "generatedBy",
    "generatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "task-analysis/v1"
    },
    "taskGroupId": {
      "type": "string",
      "minLength": 1
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "title",
          "kind"
        ],
        "properties": {
          "itemId": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "major",
              "minor"
            ]
          },
          "status": {
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "blocked"
            ]
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "note": {
            "type": "string",
            "maxLength": 2000
          },
          "workItemRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "children": {
            "type": "array",
            "items": {
              "$ref": "#/properties/items/items"
            }
          }
        }
      }
    },
    "generatedBy": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
