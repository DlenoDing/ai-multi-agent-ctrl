{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dleno.dev/ai-multi-agent-ctrl/spec/review-plan.schema.json",
  "title": "ReviewPlan",
  "description": "评审计划：声明这个任务组需要哪些评审角色到场，并记录已覆盖哪些。必需角色全覆盖即闭合。本规范此前描述的是一套更大的设计（objective / trigger / batchingDecision / reviewItems / batches / coverageMatrix / closureGate / history / auditRef），而实现从未产出过那些字段 —— 规范没被拿去校验过任何真实记录，两边就一直各说各的。现按【实际产出】收窄。收窄的依据是：它要守的不变量是「必需角色是否全部到场」，这一条由 requiredReviewerRoles 与 coveredReviewerRoles 完整表达；而任务组关闭仍有人工定稿闸门在后面挡着，批次与覆盖矩阵不是当前流程的承重件。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reviewPlanId",
    "projectId",
    "taskGroupId",
    "status",
    "requiredReviewerRoles",
    "coveredReviewerRoles",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "review-plan/v1"
    },
    "reviewPlanId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "taskGroupId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "in_progress",
        "blocked",
        "coverage_satisfied",
        "closed",
        "rejected",
        "superseded"
      ]
    },
    "reviewScopeRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredReviewerRoles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "必须到场的评审角色。为空时永远无法判定覆盖度，闭合判据会恒为假 —— 因此不允许缺省成空。"
    },
    "coveredReviewerRoles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "已提交结论的评审角色。它与 requiredReviewerRoles 的包含关系就是闭合判据。"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "closedAt": {
      "type": "string",
      "format": "date-time"
    },
    "resolvedBy": {
      "type": "string"
    },
    "resolutionJustification": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    }
  }
}
