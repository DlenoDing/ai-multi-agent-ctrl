{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dleno.local/spec/account.schema.json",
  "title": "Account",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "accountId",
    "accountType",
    "status",
    "displayName",
    "roles",
    "permissions",
    "authPolicy",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "account/v1"
    },
    "accountId": {
      "type": "string",
      "minLength": 1
    },
    "accountType": {
      "type": "string",
      "enum": [
        "system_admin",
        "user_account",
        "service_account",
        "agent_identity",
        "org_admin"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "invited",
        "active",
        "suspended",
        "locked",
        "retired"
      ]
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "email": {
      "type": "string"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "system_owner",
          "system_admin",
          "system_auditor",
          "workspace_owner",
          "project_owner",
          "project_admin",
          "task_group_owner",
          "agent_operator",
          "service_agent_runtime",
          "reviewer",
          "viewer",
          "org_admin",
          "member"
        ],
        "description": "含组织化改造引入的 org_admin 与 member（受邀成员的默认角色）。"
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "mfaRequired",
        "sessionTtlSeconds"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "bootstrap_token",
            "invite_token",
            "local_password",
            "oauth",
            "service_token",
            "no_login"
          ]
        },
        "mfaRequired": {
          "type": "boolean"
        },
        "passwordSet": {
          "type": "boolean"
        },
        "sessionTtlSeconds": {
          "type": "integer",
          "minimum": 300
        }
      }
    },
    "lastLoginAt": {
      "type": "string",
      "format": "date-time"
    },
    "auditRef": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "organizationId": {
      "type": "string",
      "minLength": 1
    },
    "defaultProjectId": {
      "type": [
        "string",
        "null"
      ]
    },
    "passwordDigest": {
      "type": "string",
      "pattern": "^(scrypt\\$\\d+\\$\\d+\\$\\d+\\$[A-Za-z0-9_-]+\\$[A-Za-z0-9_-]+|sha256:[a-fA-F0-9]{64})$",
      "description": "口令摘要。当前为 scrypt$N$r$p$salt$hash；历史 sha256 格式仍可校验，并在下次登录成功时就地升级 —— 两种都合法，否则升级期间的账号会被判为不合规。"
    },
    "activatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "账号被激活的时间。"
    },
    "credentialDigest": {
      "type": "string",
      "description": "一次性开通凭据的摘要（只存摘要）。"
    },
    "credentialIssuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "credentialExpiresAt": {
      "type": "string",
      "format": "date-time",
      "description": "开通凭据的到期时间：过期后必须重新签发，不能无限期可用。"
    },
    "credentialConsumedAt": {
      "type": "string",
      "format": "date-time",
      "description": "凭据被消费的时间；已消费即不可重放。"
    },
    "retiredAt": {
      "type": "string",
      "format": "date-time",
      "description": "注销发生的时刻。retired 是终态，这个时间点之后这个账号不会再有任何变化"
    },
    "retiredReason": {
      "type": "string",
      "maxLength": 200,
      "description": "为什么注销。事后只看得到 status=retired 的话，无从判断当初是离职、服务下线还是误操作"
    }
  }
}
