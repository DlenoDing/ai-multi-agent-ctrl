{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dleno.local/spec/internal-review-record.schema.json",
  "title": "InternalReviewRecord",
  "description": "An independent control-plane review of a work item's checkpoint. Distinct from ReviewBundle (review-bundle.schema.json), which currently models an in-control-plane advisory evidence reference bundle and not a provider-delivered external payload. Internal review records are produced and consumed inline by performIndependentReview and carry the verdict + findings the close barrier reads.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "projectId",
    "taskGroupId",
    "workItemId",
    "checkpointRef",
    "reviewerRole",
    "reviewMode",
    "verdict",
    "findings",
    "evidenceRefs",
    "status",
    "createdAt",
    "updatedAt",
    "alternativesConsidered"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "internal-review-record/v1"
    },
    "bundleId": {
      "type": "string",
      "minLength": 1
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "taskGroupId": {
      "type": "string",
      "minLength": 1
    },
    "workItemId": {
      "type": "string",
      "minLength": 1
    },
    "checkpointRef": {
      "type": "string",
      "minLength": 1
    },
    "reviewerRole": {
      "type": "string",
      "minLength": 1
    },
    "reviewMode": {
      "type": "string",
      "enum": [
        "independent_control_plane_review"
      ]
    },
    "verdict": {
      "type": "string",
      "enum": [
        "passed",
        "changes_requested"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "consumed",
        "superseded"
      ]
    },
    "supersededByHumanDecision": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "alternativesConsidered": {
      "description": "互审双轨的轨道二：跳出当前方案考察过的替代路径及取舍理由。为空视为评审未完成（sys.review-dual-track）。",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "alternative",
          "assessment"
        ],
        "properties": {
          "alternative": {
            "type": "string",
            "minLength": 1
          },
          "assessment": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "description": "标记该条目是真正的替代方案考察，还是仅为考察边界声明（control_plane_evidence_only）。",
            "enum": [
              "control_plane_evidence_only",
              "plan_level_alternative"
            ]
          }
        }
      }
    }
  }
}
