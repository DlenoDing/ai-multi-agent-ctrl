{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dleno.local/spec/organization.schema.json",
  "title": "Organization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "orgId",
    "name",
    "status",
    "quotas",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "organization/v1"
    },
    "orgId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "suspended"
      ]
    },
    "quotas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxMembers",
        "maxProjects",
        "maxTaskGroups",
        "maxAgents"
      ],
      "properties": {
        "maxMembers": {
          "type": "integer",
          "minimum": 1
        },
        "maxProjects": {
          "type": "integer",
          "minimum": 1
        },
        "maxTaskGroups": {
          "type": "integer",
          "minimum": 1
        },
        "maxAgents": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "members": {
          "type": "integer",
          "minimum": 0
        },
        "projects": {
          "type": "integer",
          "minimum": 0
        },
        "taskGroups": {
          "type": "integer",
          "minimum": 0
        },
        "agents": {
          "type": "integer",
          "minimum": 0
        },
        "agentsReserved": {
          "type": "integer",
          "minimum": 0,
          "description": "已签发但还没用掉的加入令牌数：它们占着 maxAgents 的位（签发下一张会被拒），但不计入 agents —— 节点注册查的是 agents，并进去的话节点会被自己那张正在兑换的令牌顶掉一格"
        }
      }
    },
    "initialAdminAccountId": {
      "type": "string"
    },
    "createdBy": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
