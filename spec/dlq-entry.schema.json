{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dleno.dev/ai-multi-agent-ctrl/spec/dlq-entry.schema.json",
  "title": "DLQEntry",
  "description": "进入死信队列的条目。sourceObjectRef 指向出问题的对象，reason 说明为什么进来 —— 没有这两项，DLQ 就只是一个「有东西卡住了」的计数器，人无从下手。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "entryId",
    "projectId",
    "status",
    "sourceObjectRef",
    "reason",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": "dlq-entry/v1"
    },
    "entryId": {
      "type": "string",
      "pattern": "^dlq_[a-z0-9_]+$"
    },
    "commandId": {
      "type": "string"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "taskGroupId": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "classified",
        "assigned",
        "replayed",
        "discarded",
        "superseded"
      ]
    },
    "sourceObjectRef": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "ownerRole": {
      "type": "string",
      "description": "被指派处理这条死信的角色；无人认领的死信等于没进队列。"
    },
    "rootCauseHint": {
      "type": "string",
      "description": "分类阶段给出的根因提示，供人排查。"
    }
  }
}
